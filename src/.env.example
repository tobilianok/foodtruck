APP_NAME=Foodtruck
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://foodtruck.louisrousseaux.fr

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mariadb
DB_HOST=foodtruck-db
DB_PORT=3306
DB_DATABASE=foodtruck
DB_USERNAME=foodtruck
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="foodtruck@louisrousseaux.fr"
MAIL_FROM_NAME="${APP_NAME}"

# Authentik (fournisseur OAuth2/OpenID "foodtruck")
OIDC_ISSUER=https://auth.louisrousseaux.fr/application/o/foodtruck/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES="openid email profile"
