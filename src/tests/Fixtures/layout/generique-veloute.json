{"version":1,"pages":[{"width":2480,"height":3508,"rotation":0,"blocks":[{"x":200,"y":212,"w":1137,"h":91,"size":73,"conf":96,"lines":["Velouté de potimarron"]},{"x":202,"y":388,"w":459,"h":173,"size":33,"conf":95,"lines":["Pour 4 personnes","Préparation : 15 min","Cuisson : 30 min"]},{"x":205,"y":657,"w":356,"h":57,"size":57,"conf":96,"lines":["Ingrédients"]},{"x":242,"y":768,"w":691,"h":322,"size":33,"conf":96,"lines":["- 1 potimarron (environ 1 kg)","- 2 oignons","- 20 cl de crème liquide","- 1 litre de bouillon de légumes","- sel et poivre"]},{"x":201,"y":1177,"w":1478,"h":503,"size":33,"conf":96,"lines":["Préparation","1. Éplucher le potimarron, retirer les graines et le couper en","cubes. Émincer les oignons.","2. Faire revenir les oignons 5 minutes dans une cocotte, ajouter le","potimarron et couvrir de bouillon.","3. Laisser cuire 30 minutes à feu doux puis mixer avec la crème.","Saler, poivrer et servir bien chaud."]},{"x":200,"y":1786,"w":1650,"h":44,"size":33,"conf":96,"lines":["Astuce : ajoutez quelques graines de courge grillées au moment de servir."]}]}]}